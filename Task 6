#include <stdio.h>

int main() 
{
    int num, choice;
    int i = 2;
    int is_prime = 1;

    printf("1: Check even/odd \n2: Prime\n3: Square \n4: Exit\n");
    printf("Enter your choice: ");
    scanf("%d", &choice);

    switch (choice) 
    {
        case 1:
            printf("Enter a number: ");
            scanf("%d", &num);
            if (num % 2 == 0)
                printf("%d is even\n", num);
            else
                printf("%d is odd\n", num);
            break;
            
        case 2:
            printf("Enter a number: ");
            scanf("%d", &num);
            
            if (num <= 1) {
                is_prime = 0;
            } else {
                
                while (i * i <= num) {
                    if (num % i == 0) {
                        is_prime = 0;
                        break;       
                    }
                    i++;
                }
            }
            
            if (is_prime == 1)
                printf("%d is a prime number.\n", num);
            else
                printf("%d is not a prime number.\n", num);
            break;

        case 3:
            printf("Enter a number: ");
            scanf("%d", &num);
            printf("Square of %d is %d\n", num, num * num);
            break;

        case 4:
            printf("Exiting program.\n");
            break;

        default:
            printf("Invalid choice!\n");
            break;
    }

    return 0;
}
